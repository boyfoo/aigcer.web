# Public production origin, e.g. https://your-domain.example.
# Leave unset for local/private previews. Set before building for search indexing.
SITE_URL=

# Registered data provider. Defaults to json; unknown names fail explicitly.
JINGJIE_DATA_PROVIDER=json

# Optional absolute path on a persistent volume. Defaults to web/data/.
# Runtime JSON files and content/; local uploads/ is for internal migration/static-delivery tools only.
JINGJIE_DATA_DIR=

# Shared server-side OSS configuration for admin uploads and remote MCP at /mcp.
# All four values are required for uploads and private-media access; missing configuration returns 503.
# Browser/MCP clients PUT uploads and GET previews directly from OSS; server endpoints return JSON metadata only.
# Runtime media proxy endpoints are not provided; Sites may export published media as static files.
# Never expose credentials through NEXT_PUBLIC_*.
# Bucket CORS must allow website origins for PUT, GET and HEAD.
# Allow Content-Type and x-oss-* request headers, including temporary-credential headers.
JINGJIE_OSS_BUCKET=jingjie-sh
# Region example: cn-hangzhou
JINGJIE_OSS_REGION=cn-shanghai
JINGJIE_OSS_ACCESS_KEY_ID=LTAI5t9tA41rSTPdRsAddxFp
JINGJIE_OSS_ACCESS_KEY_SECRET=
# Optional temporary credential token. Refresh credentials before they expire.
JINGJIE_OSS_SECURITY_TOKEN=
JINGJIE_OSS_PREFIX=
# Browser/MCP PUT URL lifetime in seconds (60-3600); browser confirmation tokens allow 10 more minutes.
JINGJIE_OSS_UPLOAD_TTL_SECONDS=1800
# Private media GET/HEAD link lifetime, in seconds (60-86400).
JINGJIE_OSS_ACCESS_TTL_SECONDS=3600

# Optional comma-separated exact browser origins, e.g. https://your-ai-client.example.
# Native MCP clients without Origin and same-origin browsers work without this.
JINGJIE_MCP_ALLOWED_ORIGINS=
