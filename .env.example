# Public production origin, e.g. https://your-domain.example.
# Leave unset for local/private previews. Set before building for search indexing.
SITE_URL=

# Registered data provider. Defaults to json; unknown names fail explicitly.
JINGJIE_DATA_PROVIDER=json

# Optional absolute path on a persistent volume. Defaults to web/data/.
# Runtime JSON files, content/ and uploads/; do not commit this directory.
JINGJIE_DATA_DIR=

# Optional server-side OSS configuration for the remote MCP at /mcp.
# Set all four required values to enable uploads. Never use NEXT_PUBLIC_*.
JINGJIE_OSS_BUCKET=
# Region example: cn-hangzhou
JINGJIE_OSS_REGION=
JINGJIE_OSS_ACCESS_KEY_ID=
JINGJIE_OSS_ACCESS_KEY_SECRET=
# Optional temporary credential token. Refresh credentials before they expire.
JINGJIE_OSS_SECURITY_TOKEN=
JINGJIE_OSS_PREFIX=jingjie
JINGJIE_OSS_UPLOAD_TTL_SECONDS=1800

# Optional comma-separated exact browser origins, e.g. https://your-ai-client.example.
# Native MCP clients without Origin and same-origin browsers work without this.
JINGJIE_MCP_ALLOWED_ORIGINS=
